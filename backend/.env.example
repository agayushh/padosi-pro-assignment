# Copy to backend/.env for local development outside Docker.
# Docker Compose supplies these itself. Do not commit a real .env.

DATABASE_URL=postgresql://padosi:padosi@localhost:55432/padosipro?schema=public
ACCESS_TOKEN_SECRET=dev-only-access-token-secret
OTP_PEPPER=dev-only-otp-pepper-value
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PadosiPro <noreply@padosipro.local>
PORT=3001
NODE_ENV=development
REFRESH_TOKEN_DAYS=30
