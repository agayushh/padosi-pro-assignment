generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int        @id @default(autoincrement())
  email            String     @unique
  passwordHash     String
  emailVerifiedAt  DateTime?
  name             String?
  mobile           String?
  address          String?
  businessName     String?
  profileCompleted Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  otps             EmailOtp[]
  sessions         Session[]
  tasks            UserTask[]
}

model EmailOtp {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Category {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  name        String
  description String
  sortOrder   Int
  tasks       Task[]
}

model Task {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  name        String
  description String
  categoryId  Int
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder   Int
  selections  UserTask[]

  @@index([categoryId])
}

model UserTask {
  userId    Int
  taskId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, taskId])
  @@index([taskId])
}
